    {"name": "the last line has no span and gets the estimate alone", "lines": [{"t_ms": 1000, "text": "first line here"}, {"t_ms": 2500, "text": "second line here"}, {"t_ms": 4000, "text": "third line here"}, {"t_ms": 5500, "text": "the very last line"}], "expected": [[500.0, 1000.0, 1500.0], [750.0, 1125.0, 1500.0], [500.0, 1000.0, 1500.0], [650.0, 1950.0, 2600.0, 3250.0]]},
    {"name": "a pause line and lines sharing a timestamp get nothing", "lines": [{"t_ms": 0, "text": "one two three"}, {"t_ms": 1500, "text": ""}, {"t_ms": 3000, "text": "four five six"}, {"t_ms": 4500, "text": "same time"}, {"t_ms": 4500, "text": "same time too"}, {"t_ms": 6000, "text": "seven eight nine"}, {"t_ms": 7500, "text": ""}], "expected": [[500.0, 1000.0, 1500.0], [], [500.0, 1000.0, 1500.0], [], [500.0, 1000.0, 1500.0], [750.0, 1125.0, 1500.0], []]},
    {"name": "a single line: nothing to judge its pace by", "lines": [{"t_ms": 5000, "text": "all alone"}], "expected": [[]]},
